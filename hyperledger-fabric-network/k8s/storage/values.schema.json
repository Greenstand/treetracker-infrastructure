{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "storageClass",
    "keep",
    "includeLegacy",
    "claims"
  ],
  "properties": {
    "storageClass": {
      "type": "string",
      "minLength": 1
    },
    "keep": {
      "const": true
    },
    "includeLegacy": {
      "type": "boolean"
    },
    "claims": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace",
          "size",
          "accessModes",
          "legacy",
          "create"
        ],
        "properties": {
          "namespace": {
            "enum": [
              "hlf-ca",
              "hlf-orderer",
              "hlf-peer-org"
            ]
          },
          "size": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(Gi|Ti)$"
          },
          "accessModes": {
            "type": "array",
            "items": {
              "enum": [
                "ReadWriteOnce",
                "ReadWriteOncePod"
              ]
            },
            "minItems": 1
          },
          "legacy": {
            "type": "boolean"
          },
          "create": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
